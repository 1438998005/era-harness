{
	"name": "era-harness",
	"displayName": "era harness",
	"description": "eraTW / Emuera 脚本工程的 AI 开发助手：CP932/UTF-8 安全读写、引擎日志诊断、312 页指令手册（可在线同步）、真实启动引擎验证加载。改动先出 diff，审批后才落盘；无账号、无遥测，仅本地安装。",
	"version": "3.91.8",
	"icon": "assets/icons/icon.png",
	"workspaces": [
		"."
	],
	"engines": {
		"vscode": "^1.84.0"
	},
	"license": "Apache-2.0",
	"publisher": "eraharness",
	"repository": {
		"type": "git",
		"url": "https://github.com/1438998005/era-harness"
	},
	"categories": [
		"AI",
		"Chat",
		"Programming Languages"
	],
	"keywords": [
		"eratw",
		"emuera",
		"erabasic",
		"cp932",
		"agent",
		"mcp",
		"coding",
		"ai"
	],
	"activationEvents": [
		"onLanguage",
		"onUri",
		"onStartupFinished"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"languages": [
			{
				"id": "era-erb",
				"aliases": [
					"Era ERB",
					"era-erb",
					"EraBasic"
				],
				"extensions": [
					".erb",
					".erh"
				],
				"configuration": "./assets/erabasic/language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "era-erb",
				"scopeName": "source.era-erb",
				"path": "./assets/erabasic/era-erb.tmLanguage.json"
			}
		],
		"snippets": [
			{
				"language": "era-erb",
				"path": "./assets/erabasic/snippets.json"
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "era-harness-ActivityBar",
					"title": "era harness",
					"icon": "assets/icons/icon.svg"
				}
			]
		},
		"views": {
			"era-harness-ActivityBar": [
				{
					"type": "webview",
					"id": "era-harness.SidebarProvider",
					"name": "",
					"icon": "assets/icons/icon.svg"
				}
			]
		},
		"commands": [
			{
				"command": "era-harness.plusButtonClicked",
				"title": "%cline.command.newTask%",
				"icon": "$(add)"
			},
			{
				"command": "era-harness.mcpButtonClicked",
				"title": "%cline.command.mcpServers%",
				"icon": "$(server)"
			},
			{
				"command": "era-harness.historyButtonClicked",
				"title": "%cline.command.history%",
				"icon": "$(history)"
			},
			{
				"command": "era-harness.settingsButtonClicked",
				"title": "%cline.command.settings%",
				"icon": "$(settings-gear)"
			},
			{
				"command": "era-harness.dev.createTestTasks",
				"title": "%cline.command.createTestTasks%",
				"category": "era harness",
				"when": "era-harness.isDevMode"
			},
			{
				"command": "era-harness.dev.expireMcpOAuthTokens",
				"title": "%cline.command.expireMcpOAuthTokens%",
				"category": "era harness",
				"when": "era-harness.isDevMode"
			},
			{
				"command": "era-harness.addToChat",
				"title": "%cline.command.addToChat%",
				"category": "era harness"
			},
			{
				"command": "era-harness.addTerminalOutputToChat",
				"title": "%cline.command.addTerminalToChat%",
				"category": "era harness"
			},
			{
				"command": "era-harness.focusChatInput",
				"title": "%cline.command.focusChatInput%",
				"category": "era harness"
			},
			{
				"command": "era-harness.generateGitCommitMessage",
				"title": "%cline.command.generateCommitMessage%",
				"category": "era harness",
				"icon": "$(git-commit)"
			},
			{
				"command": "era-harness.abortGitCommitMessage",
				"title": "%cline.command.abortCommitMessage%",
				"category": "era harness",
				"icon": "$(debug-stop)"
			},
			{
				"command": "era-harness.explainCode",
				"title": "%cline.command.explainCode%",
				"category": "era harness"
			},
			{
				"command": "era-harness.improveCode",
				"title": "%cline.command.improveCode%",
				"category": "era harness"
			},
			{
				"command": "era-harness.jupyterGenerateCell",
				"title": "%cline.command.jupyterGenerate%",
				"category": "era harness",
				"icon": "$(sparkle)"
			},
			{
				"command": "era-harness.jupyterExplainCell",
				"title": "%cline.command.jupyterExplain%",
				"category": "era harness",
				"icon": "$(question)"
			},
			{
				"command": "era-harness.jupyterImproveCell",
				"title": "%cline.command.jupyterImprove%",
				"category": "era harness",
				"icon": "$(lightbulb)"
			},
			{
				"command": "era-harness.reconstructTaskHistory",
				"title": "%cline.command.reconstructHistory%",
				"category": "era harness"
			},
			{
				"command": "era-harness.updateGame",
				"title": "%cline.command.updateGame%",
				"category": "era harness",
				"icon": "$(cloud-download)"
			},
			{
				"command": "era-harness.openDiagnosticsFolder",
				"title": "era harness: 打开诊断日志目录",
				"category": "era harness",
				"icon": "$(folder-opened)"
			},
			{
				"command": "era-harness.exportDiagnostics",
				"title": "era harness: 导出诊断包",
				"category": "era harness",
				"icon": "$(export)"
			},
			{
				"command": "era-harness.checkForUpdates",
				"title": "era harness: 检查更新",
				"category": "era harness",
				"icon": "$(cloud-download)"
			},
			{
				"command": "eraHarness.erabasic.yieldToSasami",
				"title": "让位给 sasami.erabasic（把 .erb/.erh 交给它高亮）",
				"category": "era harness",
				"icon": "$(arrow-swap)"
			},
			{
				"command": "eraHarness.erabasic.reclaimFiles",
				"title": "收回 .erb/.erh 的语法归属（清除本扩展写入的关联）",
				"category": "era harness"
			},
			{
				"command": "eraHarness.erabasic.revealSymbols",
				"title": "搜索工作区 ERB 符号",
				"category": "era harness"
			},
			{
				"command": "era-harness.reviewComment.reply",
				"title": "%cline.command.reply%",
				"category": "era harness",
				"enablement": "!commentIsEmpty"
			},
			{
				"command": "era-harness.reviewComment.addToChat",
				"title": "%cline.command.addToChat%",
				"category": "era harness",
				"icon": "$(link-external)"
			}
		],
		"keybindings": [
			{
				"command": "editor.action.submitComment",
				"key": "enter",
				"when": "commentEditorFocused && commentController == cline-ai-review && !commentIsEmpty"
			},
			{
				"command": "era-harness.addToChat",
				"key": "cmd+'",
				"mac": "cmd+'",
				"win": "ctrl+'",
				"linux": "ctrl+'",
				"when": "editorHasSelection"
			},
			{
				"command": "era-harness.generateGitCommitMessage",
				"when": "config.git.enabled && scmProvider == git"
			},
			{
				"command": "era-harness.focusChatInput",
				"key": "cmd+'",
				"mac": "cmd+'",
				"win": "ctrl+'",
				"linux": "ctrl+'",
				"when": "!editorHasSelection"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "era-harness.plusButtonClicked",
					"group": "navigation@1",
					"when": "view == era-harness.SidebarProvider"
				},
				{
					"command": "era-harness.mcpButtonClicked",
					"group": "navigation@2",
					"when": "view == era-harness.SidebarProvider"
				},
				{
					"command": "era-harness.historyButtonClicked",
					"group": "navigation@3",
					"when": "view == era-harness.SidebarProvider"
				},
				{
					"command": "era-harness.updateGame",
					"group": "navigation@4",
					"when": "view == era-harness.SidebarProvider"
				},
				{
					"command": "era-harness.settingsButtonClicked",
					"group": "navigation@6",
					"when": "view == era-harness.SidebarProvider"
				}
			],
			"editor/context": [
				{
					"command": "era-harness.addToChat",
					"group": "navigation",
					"when": "editorHasSelection"
				}
			],
			"terminal/context": [
				{
					"command": "era-harness.addTerminalOutputToChat",
					"group": "navigation"
				}
			],
			"scm/title": [
				{
					"command": "era-harness.generateGitCommitMessage",
					"group": "navigation",
					"when": "config.git.enabled && scmProvider == git && !era-harness.isGeneratingCommit"
				},
				{
					"command": "era-harness.abortGitCommitMessage",
					"group": "navigation",
					"when": "config.git.enabled && scmProvider == git && era-harness.isGeneratingCommit"
				}
			],
			"notebook/toolbar": [
				{
					"command": "era-harness.jupyterGenerateCell",
					"group": "navigation/add@1",
					"when": "notebookType == 'jupyter-notebook'"
				}
			],
			"notebook/cell/title": [
				{
					"command": "era-harness.jupyterExplainCell",
					"group": "inline@1",
					"when": "notebookType == 'jupyter-notebook'"
				},
				{
					"command": "era-harness.jupyterImproveCell",
					"group": "inline@2",
					"when": "notebookType == 'jupyter-notebook'"
				}
			],
			"commandPalette": [
				{
					"command": "era-harness.generateGitCommitMessage",
					"when": "config.git.enabled && !era-harness.isGeneratingCommit"
				},
				{
					"command": "era-harness.abortGitCommitMessage",
					"when": "config.git.enabled && era-harness.isGeneratingCommit"
				},
				{
					"command": "era-harness.reviewComment.reply",
					"when": "false"
				}
			],
			"comments/commentThread/context": [
				{
					"command": "era-harness.reviewComment.reply",
					"group": "inline",
					"when": "commentController == cline-ai-review"
				}
			],
			"comments/commentThread/title": [
				{
					"command": "era-harness.reviewComment.addToChat",
					"group": "inline",
					"when": "commentController == cline-ai-review"
				}
			]
		},
		"configuration": {
			"title": "era harness",
			"properties": {
				"eraHarness.erabasic.languageOwner": {
					"type": "string",
					"enum": [
						"era",
						"sasami"
					],
					"enumDescriptions": [
						"era harness 提供 .erb/.erh 的语法高亮（默认；禁用或卸载即自动归还 Ruby）",
						"把 .erb/.erh 交给 sasami.erabasic（会写入用户级 files.associations；它被卸载前请切回）"
					],
					"default": "era",
					"description": "`.erb/.erh` 的语法归属。era：由 era harness 的语言声明提供，禁用/卸载即归还 Ruby；sasami：交给 sasami.erabasic（会写入用户级 files.associations）。如果同时装了 sasami.erabasic、想让它的高亮生效，就选 sasami；不确定时保持 era。",
					"markdownDescription": "`.erb/.erh` 的语法归属。**era**：由 era harness 的语言声明提供，禁用/卸载即自动归还 Ruby；**sasami**：交给 sasami.erabasic（会写入用户级 `files.associations`）。如果同时装了 sasami.erabasic、想让它的高亮生效，就选 sasami；不确定时保持 era。"
				},
				"eraHarness.erabasic.autoTakeover": {
					"type": "boolean",
					"default": true,
					"description": "是否由 era harness 提供 .erb/.erh 的 EraBasic 补全/跳转/符号。关闭后只保留内置方法数据。语法高亮由「EraBasic 语言归属」（eraHarness.erabasic.languageOwner）控制，不在这里。"
				},
				"eraHarness.update.mirrorPrefix": {
					"type": "string",
					"default": "https://gh-proxy.com",
					"description": "「用镜像下载」按钮背后的加速前缀。只在你于更新提示里点了「用镜像下载」时才会用到，不点就永远走 GitHub 官方地址，没有任何自动改道。留空则更新提示里不出现镜像选项（彻底不引入第三方）。镜像只负责传输，收到的字节必须通过 Release 声明的 sha256 校验才会安装；资产没有 sha256 时镜像选项也不会出现。",
					"markdownDescription": "「用镜像下载」按钮背后的加速前缀。**只在你在更新提示里点了「用镜像下载」时才会用到**，不点就永远走 GitHub 官方地址，没有任何自动改道。留空则更新提示里不出现镜像选项（彻底不引入第三方）。镜像只负责传输，收到的字节必须通过 Release 声明的 sha256 校验才会安装；资产没有 sha256 时镜像选项也不会出现。"
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run package",
		"compile": "npm run check-types && npm run lint && node esbuild.mjs",
		"gate": "node scripts/gate-baseline.mjs",
		"gate:full": "node scripts/gate-baseline.mjs --compile",
		"dev": "npm run protos && npm run watch",
		"watch": "npx npm-run-all -p watch:*",
		"watch:esbuild": "node esbuild.mjs --watch",
		"watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
		"package": "npm run check-types && npm run build:webview && npm run lint && node esbuild.mjs --production",
		"protos": "node scripts/build-proto.mjs",
		"protos-python": "node scripts/build-python-proto.mjs",
		"download-ripgrep": "node scripts/download-ripgrep.mjs",
		"postprotos": "biome format src/shared/proto src/core/controller src/hosts/ webview-ui/src/services src/generated --write --no-errors-on-unmatched",
		"clean:build": "rimraf dist webview-ui/build src/generated out/",
		"clean:deps": "rimraf node_modules webview-ui/node_modules",
		"clean:all": "npm run clean:build && npm run clean:deps",
		"check-types": "npm run protos && npx tsc --noEmit && cd webview-ui && npx tsc --noEmit",
		"lint": "biome lint --no-errors-on-unmatched --files-ignore-unknown=true --diagnostic-level=error && npm run lint:proto",
		"lint:proto": "bash ./scripts/proto-lint.sh",
		"format": "biome format --changed --no-errors-on-unmatched --files-ignore-unknown=true --diagnostic-level=error",
		"format:fix": "biome check --changed --no-errors-on-unmatched --files-ignore-unknown=true --write",
		"fix:all": "biome check --no-errors-on-unmatched --files-ignore-unknown=true --write --diagnostic-level=error --unsafe",
		"ci:check-all": "npx npm-run-all -p check-types lint format",
		"ci:build": "npm run protos && npm run build:webview && node esbuild.mjs",
		"install:all": "npm install && cd webview-ui && npm install",
		"dev:webview": "cd webview-ui && npm run dev",
		"build:webview": "cd webview-ui && npm run build",
		"test:webview": "cd webview-ui && npm run test",
		"test:ui": "node webview-ui/node_modules/vitest/vitest.mjs run --root webview-ui",
		"test:toolcall": "node test/toolcall/run.mjs",
		"test:free": "node test/free/run.mjs",
		"test:deepseek": "node test/deepseek/run.mjs",
		"test:ripgrep": "node test/ripgrep/run.mjs",
		"replay:task": "node test/toolcall/run.mjs replay",
		"prepare": "npx husky",
		"test:update": "node test/update/run.mjs",
		"dryrun:update": "node test/update/run.mjs dryrun",
		"probe:update": "node test/update/run.mjs probe",
		"mergeprobe:update": "node test/update/run.mjs mergeprobe"
	},
	"lint-staged": {
		"src/shared/storage/state-keys.ts": [
			"node scripts/generate-state-proto.mjs",
			"git add proto/cline/state.proto"
		],
		"*": [
			"biome check --write --staged --no-errors-on-unmatched --files-ignore-unknown=true"
		]
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.14",
		"@bufbuild/buf": "^1.54.0",
		"@types/better-sqlite3": "^7.6.13",
		"@types/clone-deep": "^4.0.4",
		"@types/get-folder-size": "^3.0.4",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "20.x",
		"@types/pdf-parse": "^1.1.4",
		"@types/picomatch": "^4.0.2",
		"@types/shell-quote": "^1.7.5",
		"@types/turndown": "^5.0.5",
		"@types/vscode": "1.84.0",
		"@vscode/vsce": "^3.6.0",
		"chalk": "5.6.2",
		"esbuild": "^0.25.0",
		"grpc-tools": "^1.13.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.1.0",
		"npm-run-all": "^4.1.5",
		"prebuild-install": "^7.1.3",
		"protoc-gen-ts": "^0.8.7",
		"rimraf": "^6.0.1",
		"tree-kill": "^1.2.2",
		"ts-proto": "^2.6.1",
		"typescript": "^5.4.5"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.37.0",
		"@anthropic-ai/vertex-sdk": "^0.6.4",
		"@aws-sdk/client-bedrock-runtime": "^3.922.0",
		"@aws-sdk/credential-providers": "^3.922.0",
		"@azure/identity": "^4.13.0",
		"@bufbuild/protobuf": "^2.2.5",
		"@cerebras/cerebras_cloud_sdk": "^1.35.0",
		"@google-cloud/vertexai": "^1.9.3",
		"@google/genai": "^1.30.0",
		"@grpc/grpc-js": "^1.9.15",
		"@mistralai/mistralai": "^1.5.0",
		"@modelcontextprotocol/sdk": "^1.25.1",
		"@sap-ai-sdk/ai-api": "^2.7.0",
		"@sap-ai-sdk/orchestration": "^2.7.0",
		"@sap-cloud-sdk/connectivity": "^4.6.0",
		"@streamparser/json": "^0.0.22",
		"@tailwindcss/vite": "^4.1.14",
		"@types/uuid": "^10.0.0",
		"@vscode/codicons": "^0.0.36",
		"archiver": "^7.0.1",
		"aws4fetch": "^1.0.20",
		"axios": "1.15.2",
		"better-sqlite3": "^12.4.1",
		"cheerio": "^1.0.0",
		"chokidar": "^4.0.1",
		"chrome-launcher": "^1.1.2",
		"clone-deep": "^4.0.1",
		"default-shell": "^2.2.0",
		"diff": "8.0.4",
		"exceljs": "^4.4.0",
		"execa": "^9.5.2",
		"fast-deep-equal": "^3.1.3",
		"fzf": "^0.5.2",
		"get-folder-size": "^5.0.0",
		"globby": "^14.0.2",
		"iconv-lite": "^0.6.3",
		"ignore": "^7.0.3",
		"image-size": "^2.0.2",
		"isbinaryfile": "^5.0.2",
		"jschardet": "^3.1.4",
		"json5": "^2.2.3",
		"mammoth": "^1.11.0",
		"nanoid": "^5.1.6",
		"nice-grpc": "^2.1.12",
		"node-machine-id": "^1.1.12",
		"ollama": "^0.5.13",
		"open": "^10.1.2",
		"open-graph-scraper": "^6.9.0",
		"openai": "^6.21.0",
		"os-name": "^6.0.0",
		"p-mutex": "^1.0.0",
		"p-timeout": "^6.1.4",
		"p-wait-for": "^5.0.2",
		"pdf-parse": "^1.1.1",
		"picomatch": "^4.0.3",
		"reconnecting-eventsource": "^1.6.4",
		"serialize-error": "^11.0.3",
		"shell-quote": "^1.8.3",
		"simple-git": "3.36.0",
		"strip-ansi": "^7.1.2",
		"tailwindcss": "^4.1.14",
		"tree-sitter-wasms": "^0.1.11",
		"ts-morph": "^25.0.1",
		"turndown": "^7.2.0",
		"ulid": "^2.4.0",
		"undici": "^7.16.0",
		"uuid": "^11.1.0",
		"vscode-uri": "^3.1.0",
		"web-tree-sitter": "^0.22.6",
		"zod": "^3.24.2"
	},
	"overrides": {
		"tar-fs": ">=3.1.1",
		"tar": "^7.5.2",
		"vite": "^7.1.11",
		"js-yaml": "^4.1.1",
		"serialize-javascript": ">=7.0.3",
		"protobufjs": "7.5.8",
		"diff": "8.0.4"
	}
}
